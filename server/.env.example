# LogiTrack Server Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/logitrack

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=your_strong_secret_key_here_change_in_production
JWT_EXPIRES_IN=1d

# Optional Initial Admin Bootstrap (if database is empty)
ADMIN_EMAIL=admin@logitrack.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=System Administrator
